{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "enum": [
        "job_started",
        "step_started",
        "step_progress",
        "step_completed",
        "validation_started",
        "result_ready",
        "needs_local_action",
        "target_not_met",
        "job_failed",
        "job_cancelled"
      ]
    },
    "stepId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(file|out)_[A-Za-z0-9_]{1,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedUnits": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "totalUnits": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "enum": [
        null,
        "pages",
        "files",
        "candidates"
      ]
    },
    "actualSizeBytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "messageCode": {
      "type": "string",
      "maxLength": 80
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "sequence",
    "event",
    "stepId",
    "artifactRef",
    "completedUnits",
    "totalUnits",
    "unit",
    "actualSizeBytes",
    "messageCode"
  ],
  "additionalProperties": false
}
