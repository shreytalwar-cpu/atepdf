{
  "name": "atepdf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/contracts.mjs && node scripts/assets.mjs && next dev apps/web --webpack --hostname 127.0.0.1 --port 3210",
    "build": "node scripts/contracts.mjs && node scripts/assets.mjs && next build apps/web --webpack",
    "start": "next start apps/web --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --import tsx --test tests/regressions/*.test.ts",
    "test:e2e": "playwright test",
    "audit:licenses": "node scripts/licenses.mjs",
    "expo:start": "cd apps/universal && expo start --localhost",
    "expo:web": "node scripts/contracts.mjs && node scripts/assets.mjs && cd apps/universal && expo export --platform web --output-dir dist-web",
    "expo:bundles": "node scripts/contracts.mjs && cd apps/universal && expo export --platform ios --platform android --output-dir dist-native",
    "expo:preview": "node scripts/serve-expo.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ai": "7.0.118",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.48.0",
    "ajv": "8.20.0",
    "tailwindcss": "4.3.3",
    "expo": "57.0.25",
    "react-native": "0.86.3",
    "react-native-web": "0.21.3",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-sharing": "57.0.22",
    "expo-crypto": "57.0.3",
    "expo-asset": "57.0.18",
    "react-native-safe-area-context": "5.10.0",
    "lucide-react-native": "1.48.0",
    "react-native-svg": "15.15.4",
    "@expo/metro-runtime": "57.0.16"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/node": "26.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "esbuild": "0.28.2"
  }
}
